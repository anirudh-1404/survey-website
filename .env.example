# MongoDB Connection String (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Application Canonical Base URL (Used for sitemaps, robots, and SEO metadata)
NEXT_PUBLIC_APP_URL=https://pulse.org

# Optional Session Secret / Pepper
SESSION_SECRET=change_me_to_a_random_32_byte_secret_in_production

# Secure Initial Admin Provisioning (Used strictly by scripts/provision-admin.mjs)
# Do NOT store real admin passwords in committed files or production repos.
INITIAL_ADMIN_NAME=PULSE Lead Administrator
INITIAL_ADMIN_EMAIL=admin@pulse.org
INITIAL_ADMIN_PASSWORD=change_this_to_a_strong_password_before_running_script

# Cloudinary Storage Configuration (Optional / Phase 1 Poll Images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Managed Real-Time Configuration (Optional / Phase 2 Distributed Multi-Instance Pub/Sub)
# The application includes native SSE streaming out-of-the-box.
# For multi-region serverless deployments (e.g. Vercel), configure Pusher Channels:
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=mt1
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# Contact Form Email Notifications (Hostinger SMTP or Gmail)
CONTACT_NOTIFICATION_EMAIL=info@saynow.in
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@saynow.in
SMTP_PASS=your_email_password
EMAIL_FROM="SayNow" <info@saynow.in>

# Legacy / Gmail App Password Fallback:
EMAIL_USER=your_sending_gmail@gmail.com
EMAIL_PASS=your_16_digit_app_password
